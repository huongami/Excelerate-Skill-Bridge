# Copy this file to ".env" and set the values. Leave a value empty to use the default.
JINDER_PORT=8095
JINDER_HOST=127.0.0.1
# Origins that may call the API from another address, separated by commas. Example: http://localhost:5173
JINDER_CORS_ORIGINS=
# Set to 0 in a real service. The Basic/Premium switch is a demo toggle.
JINDER_ALLOW_PLAN_SWITCH=1
# Email (SMTP). Without these, messages are only recorded.
JINDER_SMTP_HOST=
JINDER_SMTP_PORT=587
JINDER_SMTP_USER=
JINDER_SMTP_PASSWORD=
JINDER_SMTP_FROM=
